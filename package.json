{
	"name": "annelie-os",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=22.12"
	},
	"packageManager": "bun@1.3.14",
	"scripts": {
		"dev": "vite dev --host 127.0.0.1 --port 3000 --strictPort",
		"build": "vite build",
		"start": "node scripts/start.mjs",
		"prepare": "svelte-kit sync",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"lint": "biome check src scripts tests *.js *.ts *.json --diagnostic-level=error && prettier --check 'src/**/*.svelte'",
		"format": "biome check --write src scripts tests *.js *.ts *.json --diagnostic-level=error && prettier --write 'src/**/*.svelte'",
		"test": "vitest run",
		"check:design": "node scripts/check-design.mjs",
		"package": "bash scripts/package-release.sh"
	},
	"devDependencies": {
		"@sveltejs/adapter-node": "5.5.7",
		"@sveltejs/kit": "2.70.3",
		"@sveltejs/vite-plugin-svelte": "7.3.0",
		"@biomejs/biome": "2.5.3",
		"@types/node": "24.13.3",
		"svelte": "5.57.0",
		"svelte-check": "4.7.6",
		"typescript": "5.9.3",
		"vite": "8.2.2",
		"vitest": "5.0.0",
		"prettier": "3.9.6",
		"prettier-plugin-svelte": "4.1.1"
	}
}
